# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Token signing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend address. Several are allowed, separated by commas.
CLIENT_URL=http://localhost:5173

# Cloudinary — product photos and verification documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayMongo — use test keys (sk_test_, pk_test_) for the evaluation
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_FAILED_URL=http://localhost:5173/payment/failed

# Brevo — sends registration codes. Optional in development: codes print in the terminal.
BREVO_API_KEY=
EMAIL_FROM=
