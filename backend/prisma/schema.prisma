generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String
  role            Role
  accountStatus   AccountStatus @default(PENDING)
  barangayId      Int?
  idDocumentUrl   String?
  certDocumentUrl String?
  address         String?       // saved delivery address, or the store address for sellers
  offersDelivery  Boolean       @default(false) // seller delivers orders
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2) // seller's flat delivery fee
  storeLat        Float?        // store pin, set by hand on the map
  storeLng        Float?

  // OCR verification fields
  // Stores the result of automated document verification
  ocrResult         String?       // AUTO_APPROVED, MANUAL_REVIEW, AUTO_REJECTED
  ocrConfidence     Float?        // confidence score 0-100
  ocrIssues         String?       // JSON string of issues found during OCR
  ocrExtractedData  String?       // JSON string of extracted fields from documents

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  products        Product[]
  notifications   Notification[]
  reviewsWritten  Review[]      @relation("ReviewBuyer")
  reviewsReceived Review[]      @relation("ReviewSeller")
  barangay        Barangay?     @relation(fields: [barangayId], references: [id])

  @@map("users")
}

// One active email code per address. Deleted once it is confirmed.
model EmailOtp {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())

  @@map("email_otps")
}

// Saved notification — the bell list. Live toasts still come by socket.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // ORDER_STATUS, PAYMENT, NEW_ORDER, LOW_STOCK, ACCOUNT, NEW_REGISTRATION
  title     String
  message   String
  link      String?  // page to open when tapped
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Barangay {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  city      String    @default("Muntinlupa City")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
  users     User[]

  @@map("barangays")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  sellerId    Int
  barangayId  Int
  categoryId  Int
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  barangay    Barangay    @relation(fields: [barangayId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  seller      User        @relation(fields: [sellerId], references: [id])

  @@map("products")
}

model Order {
  id              Int           @id @default(autoincrement())
  buyerId         Int
  status          OrderStatus   @default(RESERVED)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  deliveryType    DeliveryType
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymongoLinkId  String?       // PayMongo link ID for GCash tracking
  // Delivery snapshot — later profile edits never change a placed order
  deliveryAddress   String?
  deliveryFee       Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFeeStatus PaymentStatus? // null when there is no fee to pay
  // Set when the seller marks the order fulfilled. Ratings are required
  // only for orders with this date, so older orders never lock a buyer.
  fulfilledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  buyer           User          @relation(fields: [buyerId], references: [id])
  orderItems      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  review    Review?

  @@map("order_items")
}

// One rating per purchased item, written by the buyer after fulfillment
model Review {
  id          Int       @id @default(autoincrement())
  orderItemId Int       @unique
  productId   Int
  buyerId     Int
  sellerId    Int       // copied so store averages need no join
  rating      Int       // 1 to 5 stars
  comment     String?
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer       User      @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User      @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@map("reviews")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  RESERVED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  CASH
  GCASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}
