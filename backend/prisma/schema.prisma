generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  name            String
  email           String        @unique
  password        String
  role            Role
  accountStatus   AccountStatus @default(PENDING)
  barangayId      Int?
  idDocumentUrl   String?
  certDocumentUrl String?
  address         String?       // saved delivery address, or the store address for sellers
  offersDelivery  Boolean       @default(false) // seller delivers orders
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2) // seller's flat delivery fee
  storeLat        Float?        // store pin, set by hand on the map
  storeLng        Float?
  termsAcceptedAt DateTime?     // when the user agreed to the Terms and Privacy Policy
  // Account settings — each can change once every 7 days
  avatarUrl       String?       // profile photo on Cloudinary
  avatarChangedAt DateTime?
  nameChangedAt   DateTime?
  emailChangedAt  DateTime?
  // Seller payout account — where PropeBuy sends online sales
  payoutGcashName   String?
  payoutGcashNumber String?

  // OCR verification fields
  // Stores the result of automated document verification
  ocrResult         String?       // AUTO_APPROVED, MANUAL_REVIEW, AUTO_REJECTED
  ocrConfidence     Float?        // confidence score 0-100
  ocrIssues         String?       // JSON string of issues found during OCR
  ocrExtractedData  String?       // JSON string of extracted fields from documents

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  products        Product[]
  notifications   Notification[]
  addresses       Address[]
  reviewsWritten  Review[]      @relation("ReviewBuyer")
  reviewsReceived Review[]      @relation("ReviewSeller")
  earnings        SellerEarning[]
  payoutsReceived Payout[]      @relation("PayoutSeller")
  payoutsSent     Payout[]      @relation("PayoutAdmin")
  barangay        Barangay?     @relation(fields: [barangayId], references: [id])

  @@map("users")
}

// A buyer's saved delivery address. The default one is mirrored into
// users.address so checkout and older pages keep one place to read.
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String   // "Home", "Work", "Lola's house"
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// One active email code per address. Deleted once it is confirmed.
model EmailOtp {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())

  @@map("email_otps")
}

// Saved notification — the bell list. Live toasts still come by socket.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // ORDER_STATUS, PAYMENT, NEW_ORDER, LOW_STOCK, ACCOUNT, NEW_REGISTRATION
  title     String
  message   String
  link      String?  // page to open when tapped
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Barangay {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  city      String    @default("Muntinlupa City")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
  users     User[]

  @@map("barangays")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  sellerId    Int
  barangayId  Int
  categoryId  Int
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String?     // cover photo, always images[0] when photos exist
  images      String[]    @default([]) // up to 4 photos, cover first
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  variants    ProductVariant[]
  barangay    Barangay    @relation(fields: [barangayId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])
  seller      User        @relation(fields: [sellerId], references: [id])

  @@map("products")
}

// One option of a product (size, color, pack size) with its own price
// and stock. Switched off instead of deleted, so old orders keep it.
model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  name       String      // "Small", "Red / M", "500 ml"
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id              Int           @id @default(autoincrement())
  buyerId         Int
  status          OrderStatus   @default(RESERVED)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  deliveryType    DeliveryType
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymongoLinkId  String?       // PayMongo link ID for GCash tracking
  // Delivery snapshot — later profile edits never change a placed order
  deliveryAddress   String?
  deliveryFee       Decimal        @default(0) @db.Decimal(10, 2)
  deliveryFeeStatus PaymentStatus? // null when there is no fee to pay
  // Set when the seller marks the order fulfilled. Ratings are required
  // only for orders with this date, so older orders never lock a buyer.
  fulfilledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  buyer           User          @relation(fields: [buyerId], references: [id])
  orderItems      OrderItem[]
  earnings        SellerEarning[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId   Int?            // the option bought, when the product has variants
  variantName String?         // copied at checkout, later renames never change the order
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  review    Review?

  @@map("order_items")
}

// One rating per purchased item, written by the buyer after fulfillment
model Review {
  id          Int       @id @default(autoincrement())
  orderItemId Int       @unique
  productId   Int
  buyerId     Int
  sellerId    Int       // copied so store averages need no join
  rating      Int       // 1 to 5 stars
  comment     String?
  sellerReply String?   // the seller's public answer, one per review
  repliedAt   DateTime? // when the seller last saved the reply
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer       User      @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User      @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@map("reviews")
}

// One seller's share of an order's online payment. PropeBuy collects
// online payments first, then sends each seller their share. Pickup
// orders can mix sellers, so there is one row per order per seller.
model SellerEarning {
  id             Int           @id @default(autoincrement())
  orderId        Int
  sellerId       Int
  itemsAmount    Decimal       @db.Decimal(10, 2) // items paid online (0 for cash orders)
  deliveryFee    Decimal       @db.Decimal(10, 2) // delivery fee paid online, 100% to the seller
  commission     Decimal       @db.Decimal(10, 2) // PropeBuy commission on items paid online
  withholdingTax Decimal       @default(0) @db.Decimal(10, 2) // RR 16-2023, set on release
  netAmount      Decimal       @db.Decimal(10, 2) // what the seller receives
  status         EarningStatus @default(ON_HOLD)
  payoutId       Int?
  releasedAt     DateTime?     // order fulfilled, money can be paid out
  refundReference String?      // GCash or PayMongo reference of the refund to the buyer
  refundedAt     DateTime?     // when the admin recorded the refund
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id])
  seller         User          @relation(fields: [sellerId], references: [id])
  payout         Payout?       @relation(fields: [payoutId], references: [id])

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@map("seller_earnings")
}

// One transfer from PropeBuy to a seller's GCash, recorded by an admin
model Payout {
  id          Int             @id @default(autoincrement())
  sellerId    Int
  adminId     Int
  amount      Decimal         @db.Decimal(10, 2)
  gcashName   String
  gcashNumber String
  referenceNo String          // GCash or bank reference number of the transfer
  createdAt   DateTime        @default(now())
  seller      User            @relation("PayoutSeller", fields: [sellerId], references: [id])
  admin       User            @relation("PayoutAdmin", fields: [adminId], references: [id])
  earnings    SellerEarning[]

  @@index([sellerId])
  @@map("payouts")
}

enum EarningStatus {
  ON_HOLD    // paid online, order not fulfilled yet
  AVAILABLE  // order fulfilled, waiting for the next payout
  PAID_OUT   // sent to the seller
  REFUND_DUE // order cancelled after payment, buyer must be refunded
  REFUNDED   // refund done by the admin
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  RESERVED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  CASH
  GCASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}
